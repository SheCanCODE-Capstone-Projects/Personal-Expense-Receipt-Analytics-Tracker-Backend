# Copy to <DEPLOY_PATH>/.env on the staging server and fill in every value. Never commit the real file.
SPRING_PROFILES_ACTIVE=staging
IMAGE=ghcr.io/shecancode-capstone-projects/personal-expense-receipt-analytics-tracker-backend
DOMAIN=staging-api.example.com

# Signs access/refresh tokens. Use a different value per environment: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

# Database: choose ONE option.
# Option A, a managed PostgreSQL (e.g. Railway). Use a separate database for staging.
#   Railway shows postgresql://USER:PASSWORD@HOST:PORT/DB. Split it into JDBC form:
# DB_URL=jdbc:postgresql://HOST:PORT/DB?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=change-me
# Option B, the bundled PostgreSQL container (used when DB_URL is not set):
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Email through Brevo (https://app.brevo.com). SMTP_FROM must be a verified sender in
# Brevo → Senders, Domains & Dedicated IPs. Then choose ONE way to send:
#   A) HTTP API (works on hosts that block SMTP, e.g. Railway): Brevo → SMTP & API → API Keys
# BREVO_API_KEY=xkeysib-change-me
#   B) SMTP relay: Brevo → SMTP & API → SMTP (login …@smtp-brevo.com, and an SMTP key)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=change-me@smtp-brevo.com
SMTP_PASSWORD=xsmtpsib-change-me
SMTP_FROM=no-reply@example.com
MAIL_FROM_NAME=Expense Tracker

# The frontend origin(s) allowed to call the API from a browser, comma-separated.
CORS_ALLOWED_ORIGINS=https://staging.example.com
# Optional: None if the frontend is on a different site than the API (e.g. *.vercel.app); default Strict.
# AUTH_COOKIE_SAME_SITE=Strict
