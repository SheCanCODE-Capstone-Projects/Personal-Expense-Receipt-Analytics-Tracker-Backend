# Copy to .env (same folder) and fill in your values. The app reads .env automatically when run
# from an IDE or mvnw. Commit only this example file, never .env.
# Check it with: sh deploy/check-env.sh development .env
# Hosted (e.g. Railway): DB_URL=jdbc:postgresql://HOST:PORT/DATABASE?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/ExpenseTrackerSystem
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Email through Brevo (https://app.brevo.com). SMTP_FROM must be a verified sender in
# Brevo → Senders, Domains & Dedicated IPs. Then choose ONE way to send:
#   A) HTTP API (works on hosts that block SMTP, e.g. Railway): Brevo → SMTP & API → API Keys
# BREVO_API_KEY=xkeysib-your-api-key
#   B) SMTP relay: Brevo → SMTP & API → SMTP (login …@smtp-brevo.com, and an SMTP key)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-login@smtp-brevo.com
SMTP_PASSWORD=xsmtpsib-your-smtp-key
SMTP_FROM=you@yourdomain.com
MAIL_FROM_NAME=Expense Tracker
# Optional locally (a dev-only default is used); required in staging/production.
# JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Auth cookies (HttpOnly). Open the frontend on the same host name as the API (localhost with localhost),
# because SameSite=Strict cookies are not sent between localhost and 127.0.0.1.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict
AUTH_COOKIE_DOMAIN=
