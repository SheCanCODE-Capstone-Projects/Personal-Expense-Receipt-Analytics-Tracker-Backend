# Copy to <DEPLOY_PATH>/.env on the staging server and fill in every value. Never commit the real file.
SPRING_PROFILES_ACTIVE=staging
IMAGE=ghcr.io/shecancode-capstone-projects/personal-expense-receipt-analytics-tracker-backend
DOMAIN=staging-api.example.com

# Signs access/refresh tokens. Use a different value per environment: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=change-me-to-a-long-random-value

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=no-reply@example.com

# The frontend origin(s) allowed to call the API from a browser, comma-separated.
CORS_ALLOWED_ORIGINS=https://staging.example.com
# Optional: None if the frontend is on a different site than the API (e.g. *.vercel.app); default Strict.
# AUTH_COOKIE_SAME_SITE=Strict
